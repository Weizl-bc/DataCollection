# Set this to the deployed backend origin when needed.
VITE_API_BASE_URL=http://localhost:3002

# Response-data field configuration used by the records table.
VITE_RECORD_CERTIFICATE_FIELD_KEY=certificateNo
VITE_RECORD_CERTIFICATE_FIELD_LABEL=证书编号
VITE_RECORD_DEFAULT_STATUS=SUCCESS
VITE_RECORD_EXPORT_BUTTON_LABEL=导出Excel
VITE_RECORD_EXPORT_POLL_INTERVAL_MS=2000
VITE_RECORD_EXPORT_RETENTION_NOTICE=导出任务已创建，文件生成后仅保留3小时，请尽快下载。
VITE_RECORD_EXPORT_LIST_POLL_INTERVAL_MS=3000
VITE_RECORD_EXPORT_TASK_PAGE_SIZE=20
VITE_RECORD_EXPORT_PAGE_LABELS={"menu":"导出任务","title":"导出任务","refresh":"刷新","taskId":"任务编号","fileName":"文件名称","status":"状态","progress":"进度","totalCount":"数据总数","createdAt":"创建时间","completedAt":"完成时间","expiresAt":"过期时间","errorMessage":"失败原因","action":"操作","download":"下载","downloadSuccess":"文件下载已开始","retentionAlert":"导出文件生成后仅保留3小时，请及时下载。","totalTemplate":"共 {total} 个任务","statusQueued":"排队中","statusRunning":"生成中","statusCompleted":"已完成","statusFailed":"失败","statusExpired":"已过期"}
VITE_RECORD_DEFAULT_PAGE_SIZE=20
VITE_RECORD_RESPONSE_SECTION_LABELS={"summary":"基础字段","details":"详细内容"}
VITE_RECORD_DETAIL_SECTION_LABELS={"request":"请求参数","response":"返回数据"}

# Task-detail field labels. Keep this as valid JSON; sensitive values are never included here.
VITE_TASK_DETAIL_FIELD_LABELS={"modalTitle":"任务详情","actionViewDetail":"任务详情","sectionProgress":"整体进度","sectionParameters":"任务参数","id":"任务编号","status":"状态","startedAt":"开始时间","finishedAt":"结束时间","currentNo":"当前序号","currentCode":"当前编码","progress":"整体进度","totalCount":"总数","processedCount":"已处理","successCount":"成功","failureCount":"失败","lastError":"异常信息","startNo":"起始序号","endNo":"结束序号","year":"年份","itemCode":"项目编号","typeCode":"类型编号","stopHour":"截止时间（小时）","codePrefix":"编码前缀","codeTemplate":"编码模板","valueField":"数据字段","itemField":"项目字段","endpoint":"接口地址","referer":"来源地址","environment":"运行环境","caller":"调用方","timeoutMs":"请求超时（毫秒）","minDelayMs":"最小间隔（毫秒）","maxDelayMs":"最大间隔（毫秒）","publicKeyConfigured":"公钥状态","privateKeyConfigured":"私钥状态","accessTokenConfigured":"访问凭据状态","sensitiveHint":"出于安全考虑，密钥和访问凭据仅展示配置状态，不展示原文。"}
VITE_TASK_ACTIVE_POLL_INTERVAL_MS=3000
VITE_TASK_HISTORY_LIMIT=20
